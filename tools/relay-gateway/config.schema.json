{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Relay gateway local configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["ps5Host", "ps5Port", "bearerToken"],
  "properties": {
    "ps5Host": { "type": "string", "minLength": 1, "maxLength": 253, "description": "Configured PS5 IP address or hostname, without a URL scheme, path or port." },
    "ps5Port": { "type": "integer", "minimum": 1, "maximum": 65535 },
    "bearerToken": { "type": "string", "pattern": "^[!-~]{32,512}$", "description": "Use at least 32 cryptographically random bytes encoded as printable text. Never use the example placeholder." },
    "payload": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object", "additionalProperties": false,
          "required": ["file", "sha256", "size", "loaderPort", "capturePort"],
          "properties": {
            "file": { "type": "string", "minLength": 1, "description": "Pinned local ELF path, absolute or relative to the configuration file." },
            "sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
            "size": { "type": "integer", "minimum": 64, "maximum": 8388608 },
            "loaderPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
            "capturePort": { "type": "integer", "minimum": 1, "maximum": 65535, "description": "The capture port implemented by the pinned ELF. Must equal ps5Port; enforced by the runtime validator." }
          }
        }
      ]
    },
    "startupJournal": { "type": "string", "minLength": 1, "description": "Persistent one-attempt journal path; relative paths resolve beside the configuration file." },
    "timeouts": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "requestMs": { "type": "integer", "minimum": 50, "maximum": 30000, "default": 3000 },
        "probeMs": { "type": "integer", "minimum": 50, "maximum": 5000, "default": 4000 },
        "uploadMs": { "type": "integer", "minimum": 100, "maximum": 30000, "default": 10000 },
        "readyMs": { "type": "integer", "minimum": 100, "maximum": 60000, "default": 12000 }
      }
    }
  },
  "if": { "required": ["payload"], "properties": { "payload": { "type": "object" } } },
  "then": { "required": ["startupJournal"] }
}
