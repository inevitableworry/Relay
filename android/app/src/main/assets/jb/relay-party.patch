diff --git a/tests/http/controller_stall.c b/tests/http/controller_stall.c
new file mode 100644
--- /dev/null
+++ b/tests/http/controller_stall.c
@@ -0,0 +1,96 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+/* Confirm that a stalled native Pad call cannot starve all PBS HTTP workers.
+ * No console and no real pad are involved. */
+#include "common/http/server.h"
+#include "common/input/controller.h"
+#include <arpa/inet.h>
+#include <assert.h>
+#include <pthread.h>
+#include <stdio.h>
+#include <string.h>
+#include <sys/socket.h>
+#include <sys/time.h>
+#include <unistd.h>
+
+static pthread_mutex_t gate = PTHREAD_MUTEX_INITIALIZER;
+static pthread_cond_t wake = PTHREAD_COND_INITIALIZER;
+static int in_native_connect, native_released;
+static char connect_response[1024];
+
+static int stall_connect(void *ignored) {
+  (void)ignored;
+  pthread_mutex_lock(&gate);
+  in_native_connect=1;
+  pthread_cond_broadcast(&wake);
+  while (!native_released) pthread_cond_wait(&wake,&gate);
+  pthread_mutex_unlock(&gate);
+  return 0;
+}
+static int pad_write(void *ignored,const pbs_input_state *state) {
+  (void)ignored;(void)state;return 0;
+}
+static int pad_disconnect(void *ignored) {(void)ignored;return 0;}
+static int pad_destroy(void *ignored) {(void)ignored;return 0;}
+
+/* A bounded raw HTTP client. If any request waits behind the native Pad
+ * mutex or party admission mutex, the receive deadline makes the test fail. */
+static void http(const char *request,int expected,char response[1024]) {
+  int fd=socket(AF_INET,SOCK_STREAM,0);
+  assert(fd>=0);
+  struct timeval timeout={.tv_sec=1,.tv_usec=0};
+  assert(!setsockopt(fd,SOL_SOCKET,SO_RCVTIMEO,&timeout,sizeof timeout));
+  struct sockaddr_in address={.sin_family=AF_INET,
+      .sin_port=htons(18119),.sin_addr.s_addr=htonl(INADDR_LOOPBACK)};
+  assert(!connect(fd,(struct sockaddr *)&address,sizeof address));
+  const size_t len=strlen(request);
+  assert(send(fd,request,len,0)==(ssize_t)len);
+  shutdown(fd,SHUT_WR);
+  size_t count=0;
+  for (;;) {
+    ssize_t got=recv(fd,response+count,1023-count,0);
+    if(got<=0) break;
+    count+=(size_t)got;
+    if(count==1023) break;
+  }
+  response[count]=0;
+  close(fd);
+  char prefix[32];
+  snprintf(prefix,sizeof prefix,"HTTP/1.1 %d",expected);
+  if(!strstr(response,prefix)) fprintf(stderr,"Expected %s; got [%s]\n",prefix,response);
+  assert(strstr(response,prefix));
+}
+static void *acquiring_viewer(void *ignored) {
+  (void)ignored;
+  http("POST /party/connect HTTP/1.1\r\nHost: localhost\r\n"
+       "X-PBS-Input: 1\r\nContent-Length: 0\r\n\r\n",200,connect_response);
+  return NULL;
+}
+int main(void) {
+  const pbs_input_backend backend={stall_connect,pad_write,pad_disconnect,pad_destroy};
+  const unsigned char sps[]={0x67,0x4d,0x40,0x28},pps[]={0x68,0xee,0x3c,0x80};
+  pbs_input_configure(&backend,NULL);
+  assert(!pbs_h264_server_start(18119,1920,1080,sps,sizeof sps,pps,sizeof pps));
+  pthread_t joining;
+  assert(!pthread_create(&joining,NULL,acquiring_viewer,NULL));
+  pthread_mutex_lock(&gate);
+  while(!in_native_connect) pthread_cond_wait(&wake,&gate);
+  pthread_mutex_unlock(&gate);
+  char response[1024];
+  http("GET /config.json HTTP/1.1\r\nHost: localhost\r\n\r\n",200,response);
+  http("GET /input/status HTTP/1.1\r\nHost: localhost\r\n\r\n",503,response);
+  http("GET /party/status HTTP/1.1\r\nHost: localhost\r\n\r\n",503,response);
+  http("POST /party/connect HTTP/1.1\r\nHost: localhost\r\n"
+       "X-PBS-Input: 1\r\nContent-Length: 0\r\n\r\n",503,response);
+  pthread_mutex_lock(&gate);
+  native_released=1;
+  pthread_cond_broadcast(&wake);
+  pthread_mutex_unlock(&gate);
+  assert(!pthread_join(joining,NULL));
+  assert(strstr(connect_response,"\"player\":1"));
+  http("GET /input/status HTTP/1.1\r\nHost: localhost\r\n\r\n",200,response);
+  pbs_h264_server_stop();
+  pbs_h264_server_wait();
+  pbs_input_shutdown();
+  puts("Stalled native controller leaves config, status and admission HTTP responsive");
+  return 0;
+}
