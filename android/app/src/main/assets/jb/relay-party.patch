new file mode 100644
--- /dev/null
+++ b/payload/src/platform/ps5/party_profiles.c
@@ -0,0 +1,107 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#include "common/input/party_profiles.h"
+#include <ps5/kernel.h>
+#include <pthread.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+
+int sceKernelLoadStartModule(const char *,size_t,const void *,uint32_t,void *,uint32_t *);
+typedef struct {int32_t user_id[4];} user_list;
+static pthread_mutex_t profile_lock=PTHREAD_MUTEX_INITIALIZER;
+static struct {
+  int ready;
+  int (*initialize)(void *);
+  int (*list)(user_list *);
+  int (*name)(int32_t,char *,size_t);
+} service;
+
+static int ensure_service(void) {
+  if(service.ready) return 0;
+  uint32_t module=0;
+  if(kernel_dynlib_handle(getpid(),"libSceUserService.sprx",&module)) {
+    const int rc=sceKernelLoadStartModule("/system/common/lib/libSceUserService.sprx",0,NULL,0,NULL,NULL);
+    if(rc<=0) return -1;
+    module=(uint32_t)rc;
+  }
+  service.initialize=(void *)kernel_dynlib_dlsym(getpid(),module,"sceUserServiceInitialize");
+  service.list=(void *)kernel_dynlib_dlsym(getpid(),module,"sceUserServiceGetLoginUserIdList");
+  service.name=(void *)kernel_dynlib_dlsym(getpid(),module,"sceUserServiceGetUserName");
+  if((intptr_t)service.list<=0 || (intptr_t)service.name<=0) return -1;
+  /* A payload may already share this module with the system. Initialization
+   * returning the already-initialized code is not a reason to take ownership
+   * of the service's termination. */
+  if((intptr_t)service.initialize>0) (void)service.initialize(NULL);
+  service.ready=1;
+  return 0;
+}
+static int read_logged_users(user_list *users) {
+  if(ensure_service()) return -1;
+  for(unsigned i=0;i<4;i++) users->user_id[i]=-1;
+  return service.list(users);
+}
+static void append_json_name(char *output,size_t capacity,size_t *at,const char *name) {
+  if(*at+2>=capacity) return;
+  output[(*at)++]='"';
+  for(size_t i=0;name[i] && i<32;i++) {
+    unsigned char ch=(unsigned char)name[i];
+    if(ch<32) continue;
+    if(ch=='"' || ch=='\\') {
+      if(*at+3>=capacity) break;
+      output[(*at)++]='\\';
+    } else if(*at+2>=capacity) break;
+    output[(*at)++]=(char)ch;
+  }
+  output[(*at)++]='"';output[*at]=0;
+}
+int pbs_party_profiles_json(char *buffer,size_t capacity) {
+  if(!buffer || capacity<128) return -1;
+  pthread_mutex_lock(&profile_lock);
+  user_list users;
+  if(read_logged_users(&users)) {pthread_mutex_unlock(&profile_lock);return -1;}
+  size_t at=0;
+  at+=(size_t)snprintf(buffer+at,capacity-at,"{\"available\":true,\"users\":[");
+  unsigned emitted=0;
+  for(unsigned i=0;i<4;i++) {
+    const int32_t id=users.user_id[i];
+    if(id<=0 || id==0xff) continue;
+    char name[33]={0};
+    if(service.name(id,name,sizeof name)) continue;
+    if(at+100>=capacity) break;
+    at+=(size_t)snprintf(buffer+at,capacity-at,"%s{\"user_id\":%d,\"name\":",
+                         emitted?",":"",id);
+    append_json_name(buffer,capacity,&at,name);
+    at+=(size_t)snprintf(buffer+at,capacity-at,",\"avatar\":true}");
+    emitted++;
+  }
+  at+=(size_t)snprintf(buffer+at,capacity-at,"]}");
+  pthread_mutex_unlock(&profile_lock);
+  return (int)at;
+}
+int pbs_party_avatar(int32_t user_id,unsigned char **bytes,size_t *size,int *mime) {
+  if(!bytes || !size || !mime || user_id<=0) return -1;
+  *bytes=NULL;*size=0;*mime=0;
+  pthread_mutex_lock(&profile_lock);
+  user_list users;int allowed=0;
+  if(!read_logged_users(&users)) for(unsigned i=0;i<4;i++)
+    if(users.user_id[i]==user_id) {allowed=1;break;}
+  if(!allowed) {pthread_mutex_unlock(&profile_lock);return -1;}
+  char path[160];
+  snprintf(path,sizeof path,"/system_data/priv/cache/profile/0x%x/avatar.png",(unsigned)user_id);
+  FILE *file=fopen(path,"rb");
+  if(!file) {pthread_mutex_unlock(&profile_lock);return -1;}
+  int error=fseek(file,0,SEEK_END);
+  long len=error?-1:ftell(file);
+  if(len<8 || len>256*1024 || fseek(file,0,SEEK_SET)) {fclose(file);pthread_mutex_unlock(&profile_lock);return -1;}
+  unsigned char *image=malloc((size_t)len);
+  if(!image) {fclose(file);pthread_mutex_unlock(&profile_lock);return -1;}
+  size_t count=fread(image,1,(size_t)len,file);
+  fclose(file);pthread_mutex_unlock(&profile_lock);
+  if(count!=(size_t)len) {free(image);return -1;}
+  if(count>=8 && !memcmp(image,"\x89PNG\r\n\x1a\n",8)) *mime=1;
+  else if(count>=3 && image[0]==0xff && image[1]==0xd8 && image[2]==0xff) *mime=2;
+  else {free(image);return -1;}
+  *bytes=image;*size=count;return 0;
+}
