diff --git a/payload/src/common/input/party.c b/payload/src/common/input/party.c
new file mode 100644
--- /dev/null
+++ b/payload/src/common/input/party.c
@@ -0,0 +1,231 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#include "common/input/party.h"
+#include <errno.h>
+#include <fcntl.h>
+#include <pthread.h>
+#include <string.h>
+#include <time.h>
+#include <unistd.h>
+
+/* A lost app sends neutral input before the pad is released; native devices
+ * remain alive until payload shutdown to avoid exhausting the PS5 pad pool. */
+#define PARTY_NEUTRAL_MS 250
+#define PARTY_EXPIRE_MS 2000
+typedef struct {
+  int active, owned, pending, neutral, seen_sequence, cleanup_required;
+  int last_rc, user_prompt_sent;
+  uint32_t sequence;
+  uint64_t received, packets;
+  char token[PBS_INPUT_TOKEN_SIZE];
+  pbs_input_state state;
+} party_slot;
+
+static struct {
+  pthread_mutex_t lock;
+  pthread_cond_t changed;
+  pthread_t thread;
+  int running, thread_valid;
+  const pbs_party_backend *backend;
+  void *opaque;
+  party_slot slots[PBS_PARTY_GUESTS];
+} party = { .lock = PTHREAD_MUTEX_INITIALIZER, .changed = PTHREAD_COND_INITIALIZER };
+static const pbs_input_state neutral = {.lx=128,.ly=128,.rx=128,.ry=128};
+
+static uint64_t now_ms(void) {
+  struct timespec t;
+  clock_gettime(CLOCK_MONOTONIC, &t);
+  return (uint64_t)t.tv_sec * 1000 + (uint64_t)t.tv_nsec / 1000000;
+}
+static int valid_token(const char *token) {
+  if (!token || strlen(token) != 32) return 0;
+  for (unsigned n=0; n<32; n++)
+    if (!((token[n]>='0' && token[n]<='9') || (token[n]>='a' && token[n]<='f') ||
+          (token[n]>='A' && token[n]<='F'))) return 0;
+  return 1;
+}
+static int find_token(const char *token) {
+  if (!valid_token(token)) return -1;
+  for (int i=0; i<PBS_PARTY_GUESTS; i++) {
+    unsigned different=0;
+    for (unsigned j=0; j<32; j++)
+      different |= (unsigned char)token[j] ^ (unsigned char)party.slots[i].token[j];
+    if (!different && party.slots[i].owned) return i;
+  }
+  return -1;
+}
+static int random_token(char token[PBS_INPUT_TOKEN_SIZE]) {
+  unsigned char bytes[16]; size_t used=0;
+  int fd=open("/dev/urandom", O_RDONLY);
+  if (fd<0) return -1;
+  while (used<sizeof bytes) {
+    ssize_t n=read(fd,bytes+used,sizeof bytes-used);
+    if (n<0 && errno==EINTR) continue;
+    if (n<=0) {close(fd);return -1;}
+    used+=(size_t)n;
+  }
+  close(fd);
+  const char digits[]="0123456789abcdef";
+  for (unsigned i=0; i<16; i++) {
+    token[2*i]=digits[bytes[i]>>4];
+    token[2*i+1]=digits[bytes[i]&15];
+  }
+  token[32]=0;
+  return 0;
+}
+/* The party lock is always held by callers. */
+static int release_slot(unsigned i) {
+  party_slot *s=&party.slots[i];
+  s->active=s->pending=0;
+  if (!s->owned) return 0;
+  (void)party.backend->write(party.opaque,i,&neutral);
+  const int rc=party.backend->disconnect(party.opaque,i);
+  s->last_rc=rc; s->cleanup_required=(rc!=0);
+  if (!rc) {s->owned=0;memset(s->token,0,sizeof s->token);}
+  return rc;
+}
+static void *worker(void *ignored) {
+  (void)ignored;
+  pthread_mutex_lock(&party.lock);
+  while (party.running) {
+    int active=0;
+    for (unsigned i=0; i<PBS_PARTY_GUESTS; i++) {
+      party_slot *s=&party.slots[i];
+      if (!s->active) continue;
+      active=1;
+      uint64_t elapsed=now_ms()-s->received;
+      if (elapsed>=PARTY_EXPIRE_MS) release_slot(i);
+      else if (elapsed>=PARTY_NEUTRAL_MS && !s->neutral) {
+        int rc=party.backend->write(party.opaque,i,&neutral);
+        s->last_rc=rc; s->neutral=1; s->pending=0;
+        if (rc) release_slot(i);
+      } else if (s->pending) {
+        int rc=party.backend->write(party.opaque,i,&s->state);
+        s->last_rc=rc; s->pending=0; s->neutral=0;
+        if (rc) release_slot(i);
+      }
+    }
+    if (!party.running) break;
+    if (!active) pthread_cond_wait(&party.changed,&party.lock);
+    else {
+      struct timespec deadline;clock_gettime(CLOCK_REALTIME,&deadline);
+      deadline.tv_nsec+=8000000;
+      if (deadline.tv_nsec>=1000000000) {deadline.tv_sec++;deadline.tv_nsec-=1000000000;}
+      pthread_cond_timedwait(&party.changed,&party.lock,&deadline);
+    }
+  }
+  for (unsigned i=0; i<PBS_PARTY_GUESTS; i++)
+    if (party.slots[i].owned && !party.slots[i].cleanup_required) release_slot(i);
+  pthread_mutex_unlock(&party.lock);
+  return NULL;
+}
+void pbs_party_configure(const pbs_party_backend *backend,void *opaque) {
+  pthread_mutex_lock(&party.lock);
+  if (!party.thread_valid) {party.backend=backend;party.opaque=opaque;}
+  pthread_mutex_unlock(&party.lock);
+}
+int pbs_party_start(void) {
+  pthread_mutex_lock(&party.lock);
+  int rc=0;
+  if (party.backend && !party.thread_valid) {
+    party.running=1;rc=pthread_create(&party.thread,NULL,worker,NULL);
+    if (rc) party.running=0; else party.thread_valid=1;
+  }
+  pthread_mutex_unlock(&party.lock);
+  return rc;
+}
+void pbs_party_stop(void) {
+  pthread_mutex_lock(&party.lock);
+  party.running=0;pthread_cond_broadcast(&party.changed);
+  pthread_mutex_unlock(&party.lock);
+}
+void pbs_party_wait(void) {
+  if (party.thread_valid) {pthread_join(party.thread,NULL);party.thread_valid=0;}
+}
+void pbs_party_shutdown(void) {
+  pthread_mutex_lock(&party.lock);
+  if (party.backend) for (unsigned i=0; i<PBS_PARTY_GUESTS; i++) {
+    party_slot *s=&party.slots[i];
+    if (s->owned) (void)party.backend->write(party.opaque,i,&neutral);
+    const int rc=party.backend->destroy(party.opaque,i);
+    s->last_rc=rc;s->cleanup_required=rc!=0;
+    if (!rc) {s->owned=s->active=0;memset(s->token,0,sizeof s->token);}
+  }
+  pthread_mutex_unlock(&party.lock);
+}
+int pbs_party_connect(char token[PBS_INPUT_TOKEN_SIZE],unsigned *player,
+                      unsigned requested_player) {
+  if(requested_player != 0 && (requested_player<2 || requested_player>4)) return 400;
+  int code=409;
+  pthread_mutex_lock(&party.lock);
+  if (!party.backend) code=501;
+  else if (!party.running) code=409;
+  else for (unsigned i=0; i<PBS_PARTY_GUESTS; i++) {
+    if(requested_player && i+2 != requested_player) continue;
+    party_slot *s=&party.slots[i];
+    if (s->owned || s->cleanup_required) continue;
+    if (random_token(s->token)) {code=503;break;}
+    s->owned=1;
+    int rc=party.backend->connect(party.opaque,i);
+    if (!rc) rc=party.backend->write(party.opaque,i,&neutral);
+    s->last_rc=rc;
+    if (rc) {
+      release_slot(i);s->last_rc=rc;code=503;
+    } else {
+      s->active=1;s->received=now_ms();s->pending=0;s->neutral=1;
+      s->seen_sequence=0;s->user_prompt_sent=0;s->packets=0;
+      memcpy(token,s->token,PBS_INPUT_TOKEN_SIZE);
+      if(player) *player=i+2;
+      pthread_cond_broadcast(&party.changed);code=200;
+    }
+    break;
+  }
+  pthread_mutex_unlock(&party.lock);
+  return code;
+}
+int pbs_party_submit(const char *token,uint32_t sequence,const pbs_input_state *state) {
+  if (!state || (state->buttons & ~PBS_INPUT_BUTTONS)) return 400;
+  if (pthread_mutex_trylock(&party.lock)) return 503;
+  const int index=find_token(token);
+  int code=200;
+  if (index<0) code=403;
+  else {
+    party_slot *s=&party.slots[index];
+    if (!s->active || !party.running) code=409;
+    else if (s->seen_sequence && (int32_t)(sequence-s->sequence)<=0) code=409;
+    else {
+      s->sequence=sequence;s->seen_sequence=1;s->state=*state;
+      /* One PS press is permitted for the console's native user picker.
+       * Later system-button presses belong to the main controller. */
+      if (s->state.buttons & PBS_INPUT_PS_BUTTON) {
+        if (s->user_prompt_sent) s->state.buttons &= ~PBS_INPUT_PS_BUTTON;
+        else s->user_prompt_sent=1;
+      }
+      s->received=now_ms();s->packets++;s->pending=1;
+      pthread_cond_broadcast(&party.changed);
+    }
+  }
+  pthread_mutex_unlock(&party.lock);
+  return code;
+}
+int pbs_party_disconnect(const char *token) {
+  if (pthread_mutex_trylock(&party.lock)) return 503;
+  const int index=find_token(token);
+  int code=index<0?403:release_slot((unsigned)index)?503:200;
+  pthread_mutex_unlock(&party.lock);
+  return code;
+}
+int pbs_party_owns(const char *token) {
+  if (pthread_mutex_trylock(&party.lock)) return 0;
+  int result=find_token(token)>=0;
+  pthread_mutex_unlock(&party.lock);return result;
+}
+int pbs_party_get_status(pbs_party_slot_status slots[PBS_PARTY_GUESTS]) {
+  if (!slots || pthread_mutex_trylock(&party.lock)) return -1;
+  for (unsigned i=0; i<PBS_PARTY_GUESTS; i++) {
+    party_slot *s=&party.slots[i];
+    slots[i]=(pbs_party_slot_status){.connected=s->active,.cleanup_required=s->cleanup_required,
+      .last_rc=s->last_rc,.user_prompt_sent=s->user_prompt_sent,.packets=s->packets};
+  }
+  pthread_mutex_unlock(&party.lock);
+  return 0;
+}
