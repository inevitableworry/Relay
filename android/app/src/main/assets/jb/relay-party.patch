diff --git a/payload/src/common/http/party_routes.h b/payload/src/common/http/party_routes.h
new file mode 100644
--- /dev/null
+++ b/payload/src/common/http/party_routes.h
@@ -0,0 +1,118 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+/* Included after controller_routes.h: shares its header and state validators. */
+#include "common/input/party.h"
+#include "common/input/party_profiles.h"
+/* Serialize newly arriving clients so the primary native pad always belongs to
+ * the first successful connection; later clients use guest pads in order. */
+static pthread_mutex_t party_admission_lock = PTHREAD_MUTEX_INITIALIZER;
+static void party_reply_status(int fd) {
+  pbs_input_status primary;
+  pbs_party_slot_status guest[PBS_PARTY_GUESTS];
+  if (pbs_input_get_status(&primary) || pbs_party_get_status(guest)) {
+    profile_reply(fd,503,"A native controller operation is still in progress");
+    return;
+  }
+  const int connected=(primary.connected?1:0)+guest[0].connected+guest[1].connected+guest[2].connected;
+  char body[768];
+  int n=snprintf(body,sizeof body,
+    "{\"version\":1,\"max_players\":4,\"connected\":%d,\"players\":["
+    "{\"player\":1,\"connected\":%s,\"cleanup_required\":%s,\"prompt_sent\":%s},"
+    "{\"player\":2,\"connected\":%s,\"cleanup_required\":%s,\"prompt_sent\":%s},"
+    "{\"player\":3,\"connected\":%s,\"cleanup_required\":%s,\"prompt_sent\":%s},"
+    "{\"player\":4,\"connected\":%s,\"cleanup_required\":%s,\"prompt_sent\":%s}]}",
+    connected,primary.connected?"true":"false",primary.cleanup_required?"true":"false",
+    primary.connected?"true":"false",
+    guest[0].connected?"true":"false",guest[0].cleanup_required?"true":"false",
+    guest[0].user_prompt_sent?"true":"false",
+    guest[1].connected?"true":"false",guest[1].cleanup_required?"true":"false",
+    guest[1].user_prompt_sent?"true":"false",
+    guest[2].connected?"true":"false",guest[2].cleanup_required?"true":"false",
+    guest[2].user_prompt_sent?"true":"false");
+  if (n>0 && n<(int)sizeof body) reply(fd,"application/json",body,(size_t)n);
+  else profile_reply(fd,503,"Player status is unavailable");
+}
+static void party_route(int fd,const char *method,const char *path,
+                        const char *request,size_t received) {
+  if (!strcmp(method,"GET") && !strcmp(path,"/party/status")) {
+    party_reply_status(fd); return;
+  }
+  if (!strcmp(method,"GET") && (!strcmp(path,"/party/users") ||
+                                !strncmp(path,"/party/avatar?user_id=",22))) {
+    controller_request auth;const char *error=NULL;
+    int rc=controller_parse_request(request,&auth,&error);
+    if(rc!=200) {profile_reply(fd,rc,error);return;}
+    if(!auth.has_token || (!pbs_input_owns(auth.token) && !pbs_party_owns(auth.token))) {
+      profile_reply(fd,403,"An active player token is required");return;
+    }
+    if(!strcmp(path,"/party/users")) {
+      char body[1024];
+      int len=pbs_party_profiles_json(body,sizeof body);
+      if(len<0) profile_reply(fd,501,"Console user profiles are unavailable");
+      else reply(fd,"application/json",body,(size_t)len);
+      return;
+    }
+    const char *number=path+22;
+    if(!*number) {profile_reply(fd,400,"Invalid user ID");return;}
+    for(const char *p=number;*p;p++) if(*p<'0'||*p>'9') {
+      profile_reply(fd,400,"Invalid user ID");return;
+    }
+    errno=0;char *tail=NULL;
+    unsigned long id=strtoul(number,&tail,10);
+    if(errno || *tail || id==0 || id>INT32_MAX) {
+      profile_reply(fd,400,"Invalid user ID");return;
+    }
+    unsigned char *bytes=NULL;size_t count=0;int mime=0;
+    if(pbs_party_avatar((int32_t)id,&bytes,&count,&mime)) {
+      profile_reply(fd,404,"Avatar is unavailable");return;
+    }
+    reply(fd,mime==1?"image/png":"image/jpeg",bytes,count);
+    free(bytes);return;
+  }
+  if (strcmp(method,"POST")) {profile_reply(fd,405,"Use POST for party controller commands");return;}
+  int connecting=!strcmp(path,"/party/connect");
+  int disconnecting=!strcmp(path,"/party/disconnect");
+  if (!connecting && !disconnecting && strcmp(path,"/party/state")) {
+    profile_reply(fd,404,"Unknown party command");return;
+  }
+  controller_request parsed;const char *error=NULL;
+  int status=controller_parse_request(request,&parsed,&error);
+  if (status!=200) {profile_reply(fd,status,error);return;}
+  if ((connecting || disconnecting) && parsed.content_length) {
+    profile_reply(fd,400,"Unexpected controller body");return;
+  }
+  if (!connecting && (!parsed.has_token || strlen(parsed.token)!=32)) {
+    profile_reply(fd,403,"Player token required");return;
+  }
+  if (connecting) {
+    char token[PBS_INPUT_TOKEN_SIZE];unsigned player=0;
+    /* Keep all later clients responsive when the very first native Pad
+     * registration hangs inside libScePad. No duplicate native add occurs. */
+    if (pthread_mutex_trylock(&party_admission_lock)) {
+      profile_reply(fd,503,"Another player controller is still initializing");
+      return;
+    }
+    status=pbs_input_connect(token);
+    if(status==200) {
+      player=1;
+    } else if(status==409) {
+      pbs_input_status primary;
+      if (!pbs_input_get_status(&primary) &&
+          primary.connected && !primary.cleanup_required)
+        status=pbs_party_connect(token,&player,0);
+      else status=503;
+    }
+    pthread_mutex_unlock(&party_admission_lock);
+    if (status!=200) {profile_reply(fd,status,controller_result_message(status));return;}
+    char body[96];
+    int length=snprintf(body,sizeof body,"{\"token\":\"%s\",\"player\":%u}",token,player);
+    reply(fd,"application/json",body,(size_t)length);return;
+  }
+  if (disconnecting) status=pbs_party_disconnect(parsed.token);
+  else {
+    uint32_t sequence;pbs_input_state state;
+    status=controller_read_state(fd,request,received,&parsed,&sequence,&state,&error);
+    if(status!=200) {profile_reply(fd,status,error);return;}
+    status=pbs_party_submit(parsed.token,sequence,&state);
+  }
+  profile_reply(fd,status,controller_result_message(status));
+}
