diff --git a/payload/src/common/http/profile_controls.h b/payload/src/common/http/profile_controls.h
new file mode 100644
--- /dev/null
+++ b/payload/src/common/http/profile_controls.h
@@ -0,0 +1,38 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#pragma once
+#include <errno.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+
+#define PBS_RATE_MIN_BPS 1000000u
+#define PBS_RATE_MAX_BPS 100000000u
+#define PBS_RATE_MIN_QP 18u
+#define PBS_RATE_MAX_QP 35u
+typedef struct { int height, has_rate; uint32_t bitrate, min_qp; } pbs_profile_request;
+
+/* Strict decimal parsing; reject overflow, signs, missing fields and trailing query data. */
+static int pbs_profile_decimal(const char **cursor, const char *key, uint32_t maximum, uint32_t *value) {
+  size_t size = strlen(key);
+  if (strncmp(*cursor, key, size)) return -1;
+  const char *number = *cursor + size;
+  if (*number < '0' || *number > '9') return -1;
+  char *end = NULL;
+  errno = 0;
+  unsigned long parsed = strtoul(number, &end, 10);
+  if (errno || end == number || parsed > maximum) return -1;
+  *value = (uint32_t)parsed; *cursor = end;
+  return 0;
+}
+static int pbs_profile_parse(const char *path, pbs_profile_request *request) {
+  uint32_t height = 0;
+  memset(request, 0, sizeof *request);
+  if (pbs_profile_decimal(&path, "/capture/profile?height=", 2160, &height)) return -1;
+  request->height = (int)height;
+  if (!*path) return 0;
+  if (pbs_profile_decimal(&path, "&bitrate=", PBS_RATE_MAX_BPS, &request->bitrate) ||
+      pbs_profile_decimal(&path, "&minqp=", PBS_RATE_MAX_QP, &request->min_qp) || *path ||
+      request->bitrate < PBS_RATE_MIN_BPS || request->min_qp < PBS_RATE_MIN_QP) return -1;
+  request->has_rate = 1;
+  return 0;
+}
