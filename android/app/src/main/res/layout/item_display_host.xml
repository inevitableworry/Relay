<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="260dp"
    android:layout_marginStart="5dp"
    android:layout_marginEnd="5dp"
    android:layout_marginTop="7dp"
    android:layout_marginBottom="7dp"
    android:focusable="true"
    android:clickable="true"
    android:foreground="?android:attr/selectableItemBackground"
    app:cardBackgroundColor="@color/portal_card"
    app:cardCornerRadius="22dp"
    app:cardElevation="5dp"
    app:cardUseCompatPadding="false">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/portal_home_background">
        <ImageView
            android:id="@+id/stateIndicatorImageView"
            android:layout_width="178dp"
            android:layout_height="145dp"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="9dp"
            android:layout_marginBottom="17dp"
            android:alpha="0.75"
            android:src="@drawable/ic_console_ps5"
            android:contentDescription="@string/portal_console_illustration"/>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingTop="15dp"
            android:paddingBottom="14dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/hostStatusTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@color/portal_chip"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="5dp"
                    android:paddingBottom="5dp"
                    android:textColor="@color/portal_accent_light"
                    android:textSize="10sp"
                    android:letterSpacing="0.10"
                    android:fontFamily="sans-serif-medium"
                    tools:text="READY"/>
                <TextView
                    android:id="@+id/consoleTypeTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="@string/portal_ps5"
                    android:textColor="@color/portal_muted"
                    android:textSize="11sp"
                    android:letterSpacing="0.08"/>
            </LinearLayout>
            <TextView
                android:id="@+id/nameTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:textColor="@color/portal_white"
                android:textSize="23sp"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:ellipsize="end"
                tools:text="Living Room PS5"/>
            <TextView
                android:id="@+id/hostTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:textColor="@color/portal_muted"
                android:textSize="13sp"
                android:maxLines="1"
                android:ellipsize="end"
                tools:text="Address: 192.0.2.10"/>
            <TextView
                android:id="@+id/idTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:textColor="@color/portal_muted"
                android:textSize="11sp"
                android:ellipsize="end"
                android:maxLines="1"
                tools:text="ID: C0FFEE1337 (registered)"/>
            <View
                android:layout_width="1dp"
                android:layout_height="0dp"
                android:layout_weight="1"/>
            <TextView
                android:id="@+id/bottomInfoTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingEnd="92dp"
                android:textColor="@color/portal_white"
                android:textSize="12sp"
                android:maxLines="2"
                android:ellipsize="end"
                tools:text="App: Persona 5"/>
        </LinearLayout>
        <FrameLayout
            android:id="@+id/discoveredIndicatorLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="12dp">
            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_discovered_on_secondary"
                android:contentDescription="@string/portal_discovery_icon"/>
        </FrameLayout>
        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/menuButton"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_gravity="top|end"
            android:padding="10dp"
            android:src="@drawable/ic_overflow"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/portal_console_options"
            app:tint="@color/portal_white"/>
    </FrameLayout>
</androidx.cardview.widget.CardView>
