<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/portalRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#07070c"
    android:focusableInTouchMode="true">

    <com.metallic.chiaki.main.PortalBackdropView
        android:id="@+id/portalBackdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"/>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/portalLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="32dp"
        android:paddingEnd="32dp"
        android:paddingTop="22dp"
        android:paddingBottom="28dp">

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/titleGuide"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent="0.20"/>

        <!-- Native vector silhouettes measured from the official 2025 UI. Hit targets stay native. -->
        <FrameLayout
            android:id="@+id/portalTabSwitcher"
            android:layout_width="180dp"
            android:layout_height="50dp"
            android:contentDescription="Remote Play, Cloud Streaming, Search"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <ImageView
                android:id="@+id/portalTabArtwork"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitXY"
                android:src="@drawable/portal_nav_remote"
                android:importantForAccessibility="no"/>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal">
                <View
                    android:id="@+id/remoteTab"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="Remote Play"/>
                <View
                    android:id="@+id/cloudTab"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="Cloud Streaming"/>
                <View
                    android:id="@+id/searchTab"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="Search"/>
            </LinearLayout>
        </FrameLayout>

        <LinearLayout
            android:id="@+id/statusBar"
            android:layout_width="wrap_content"
            android:layout_height="50dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingEnd="1dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <ImageView
                android:id="@+id/wifiIndicator"
                android:layout_width="21dp"
                android:layout_height="21dp"
                android:src="@drawable/portal_status_wifi"
                android:contentDescription="Wi-Fi"/>
            <ImageView
                android:id="@+id/batteryIndicator"
                android:layout_width="25dp"
                android:layout_height="21dp"
                android:layout_marginStart="22dp"
                android:src="@drawable/portal_status_battery"
                android:contentDescription="Battery"/>
            <TextView
                android:id="@+id/timeText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="17dp"
                android:text="--:--"
                android:textColor="#ffffff"
                android:fontFamily="sans-serif"
                android:textSize="15sp"/>
            <ImageButton
                android:id="@+id/quickMenuButton"
                android:layout_width="43dp"
                android:layout_height="43dp"
                android:layout_marginStart="16dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/portal_status_sliders"
                android:padding="10dp"
                android:focusable="true"
                android:contentDescription="Quick menu"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/remoteContent"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="0dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/titleGuide">
            <TextView
                android:id="@+id/portalConsoleTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Looking for your console"
                android:textSize="24sp"
                android:maxLines="2"
                android:ellipsize="end"
                android:fontFamily="sans-serif-light"
                android:textColor="#ffffff"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Select console"/>
            <TextView
                android:id="@+id/portalConsoleMeta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textColor="#b9b5cf"
                android:textSize="12sp"
                android:visibility="gone"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/cloudContent"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="0dp"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/titleGuide">
            <TextView
                android:id="@+id/cloudHeading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Cloud Streaming with PlayStation Plus Premium"
                android:textColor="#ffffff"
                android:textSize="19sp"
                android:fontFamily="sans-serif-light"/>
            <TextView
                android:id="@+id/cloudMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="34dp"
                android:maxWidth="540dp"
                android:text="Cloud game streaming is not available in this Remote Play client."
                android:textColor="#c0bed0"
                android:textSize="15sp"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/searchContent"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/portalTabSwitcher"
            app:layout_constraintBottom_toTopOf="@id/bottomHint"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">
            <EditText
                android:id="@+id/portalSearch"
                android:layout_width="540dp"
                android:layout_height="56dp"
                android:layout_gravity="center_horizontal"
                android:background="@drawable/portal_search_field"
                android:drawableStart="@drawable/portal_status_search"
                android:drawablePadding="14dp"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:hint="Search paired consoles"
                android:singleLine="true"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:textColor="#ffffff"
                android:textColorHint="#bdbbc6"
                android:textSize="16sp"/>
            <TextView
                android:id="@+id/searchHeading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="25dp"
                android:layout_marginBottom="8dp"
                android:text="Your Consoles"
                android:textSize="18sp"
                android:textColor="#ffffff"/>
            <HorizontalScrollView
                android:id="@+id/searchResultsScroll"
                android:layout_width="match_parent"
                android:layout_height="208dp"
                android:scrollbars="none">
                <LinearLayout
                    android:id="@+id/portalSearchResults"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"/>
            </HorizontalScrollView>
        </LinearLayout>

        <TextView
            android:id="@+id/bottomHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="L1 / R1  Switch Tabs"
            android:textColor="#ffffff"
            android:textSize="13sp"
            android:fontFamily="sans-serif"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/portalConnect"
            android:layout_width="178dp"
            android:layout_height="49dp"
            app:backgroundTint="#ffffff"
            app:cornerRadius="99dp"
            android:text="Connect"
            android:textColor="#090909"
            android:textAllCaps="false"
            android:textSize="15sp"
            android:fontFamily="sans-serif-medium"
            android:focusable="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
