# Experimental tvOS 9+ UIKit shell. Requires AppleTV SDK in TheosWin.
export ARCHS = arm64
TARGET = appletv:clang:16.5:9.0
include $(THEOS)/makefiles/common.mk
APPLICATION_NAME = Relay
Relay_FILES = RelayApp/RelayApp.m
Relay_FRAMEWORKS = UIKit Foundation QuartzCore
Relay_CFLAGS = -fobjc-arc
Relay_RESOURCE_FILES = RelayApp/Info-tvOS.plist
include $(THEOS_MAKE_PATH)/application.mk
